{
  "name": "safeexit",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:reset": "node scripts/dev-reset.mjs",
    "dev:clean": "node scripts/dev-reset.mjs --ports && node --max-old-space-size=4096 ./node_modules/next/dist/bin/next dev --webpack",
    "dev": "node --max-old-space-size=4096 ./node_modules/next/dist/bin/next dev --webpack",
    "dev:turbo": "node --max-old-space-size=4096 ./node_modules/next/dist/bin/next dev",
    "build": "node --max-old-space-size=4096 ./node_modules/next/dist/bin/next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^13.3.0",
    "@yudiel/react-qr-scanner": "^2.6.0",
    "canvas-confetti": "^1.9.4",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-qr-code": "^2.0.21"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4"
  }
}
