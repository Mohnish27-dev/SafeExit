# SafeExit — backend environment.
#
# Copy to .env and fill in. .env is gitignored and must stay that way: the real file holds
# the database password, the SMTP password, the push private key and the admin PINs.
#
# Only JWT_SECRET and DATABASE_URL are required. Everything else has a working default,
# and the app tells you at boot when an optional feature is off for want of a variable.
#
# MONGO_URI is NOT here. Nothing under src/ reads it any more.

# =============================================================================
# REQUIRED
# =============================================================================

# Signs the session tokens. Generate a fresh one per deployment and never reuse the
# development value:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it signs everyone out, which is the correct behaviour if it ever leaks.
JWT_SECRET=

# The single source of truth for the database connection.
#
# HOST NAME, ON A DOCKER DEPLOYMENT: 127.0.0.1 inside a container is the CONTAINER, not the
# machine. If PostgreSQL runs on the host rather than in Compose, use host.docker.internal —
# docker-compose.prod.yml maps it to the host gateway for exactly this. A database on
# another machine takes its real hostname or address.
DATABASE_URL=postgres://safeexit:CHANGE_ME@host.docker.internal:5432/safeexit

# =============================================================================
# ADMIN ACCESS — the real security boundary for the admin console
# =============================================================================
#
# Numbered from 1 and scanned until the first gap, so ADMIN_3_* is ignored if ADMIN_2_* is
# missing. The server provisions these accounts on every boot (utils/ensureAdmins.js), so
# adding an admin is an env change and a restart, not a database edit.
#
# With none set, the admin console has no authorised users and says so in the boot log.

ADMIN_1_NAME=
ADMIN_1_ID=
ADMIN_1_PIN=

# ADMIN_2_NAME=
# ADMIN_2_ID=
# ADMIN_2_PIN=

# =============================================================================
# HTTP
# =============================================================================

PORT=5000
NODE_ENV=production

# Where the browser loads the app from. This is the CORS allowlist, so it must match the
# address people actually type, scheme included.
FRONTEND_URL=http://safeexit.nitp.ac.in

# Cookie flags, set explicitly rather than guessed from NODE_ENV. Secure=true over plain
# HTTP silently drops the cookie and kills the live event stream, because EventSource
# cannot send an Authorization header. Leave COOKIE_SECURE=false until TLS is terminated.
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# HSTS is a one-way door: once a browser caches it, that host is HTTPS-only there for a
# year. On a plain-HTTP campus deployment one accidental HTTPS hit would leave the gate
# station unable to load the app. Turn it on only after TLS works.
ENABLE_HSTS=0

# =============================================================================
# MAINTENANCE
# =============================================================================
#
# MAINTENANCE_MODE=true refuses every POST/PUT/PATCH/DELETE with 503 while leaving reads,
# the roster and the event stream working. Logging in is refused too, so keep windows short.
# Restart the backend after changing it; the compose file reads this file through env_file,
# so no image rebuild is needed.

MAINTENANCE_MODE=false
# MAINTENANCE_MESSAGE=SafeExit is briefly read-only for maintenance. Try again shortly.
# MAINTENANCE_RETRY_AFTER=900

# Accepts a MongoDB ObjectId as a token subject, resolved through legacy_id. It exists only
# for the two weeks after a migration FROM MongoDB. A database that was never migrated has
# no legacy_id values, so leave this false.
LEGACY_ID_GRACE=false

# =============================================================================
# DATABASE TUNING — every default is deliberate; see src/config/postgres.js
# =============================================================================

# Must stay well under the server's own max_connections, which is shared with everything
# else on that machine. Confirm it with `npm run pg:check` before raising this.
# PG_MAX_POOL_SIZE=20

# The defaults exist so a database that stops answering becomes an error in seconds rather
# than a spinner at the gate. Raise them only with a reason.
# PG_CONNECTION_TIMEOUT_MS=10000
# PG_IDLE_TIMEOUT_MS=30000
# PG_STATEMENT_TIMEOUT_MS=30000
# PG_APPLICATION_NAME=safeexit

# TLS to the database. A campus LAN server will not want it; a managed one will.
# PGSSLMODE=require

# Logs every statement with its duration. Useful once, never in production.
# SQL_LOG=false

# =============================================================================
# EMAIL — one-time codes and password resets
# =============================================================================
#
# With SMTP_HOST, SMTP_USER and SMTP_PASS all set, mail is sent. With any of them missing,
# mail is logged to the console instead and the app runs normally — which is a reasonable
# way to start, since nothing at the gate depends on email.

# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=SafeExit <no-reply@nitp.ac.in>

# =============================================================================
# BROWSER PUSH NOTIFICATIONS
# =============================================================================
#
# Optional. Without a key pair, push is a no-op and the app says so at boot.
# Generate with:  npx web-push generate-vapid-keys

# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@nitp.ac.in

# =============================================================================
# PASSKEYS (WebAuthn)
# =============================================================================
#
# RP_ID must be the registration domain with no scheme and no port, and RP_ORIGIN must be
# the exact origin including scheme. A mismatch fails registration with an opaque error.
# Passkeys require HTTPS everywhere except localhost.

# RP_NAME=SafeExit
# RP_ID=safeexit.nitp.ac.in
# RP_ORIGIN=https://safeexit.nitp.ac.in

# =============================================================================
# LIMITS
# =============================================================================

# Live event stream. The cap is what stops a slow client from growing the buffer unbounded.
# SSE_MAX_CLIENTS=200
# SSE_MAX_BUFFERED_BYTES=1048576

# List endpoints.
# PAGE_DEFAULT_LIMIT=50
# PAGE_MAX_LIMIT=200

# Per-IP caps on registration and one-time codes.
# REGISTER_IP_MAX=10
# OTP_IP_MAX=20

# Exposes /api/_diag, which reports what req.ip actually resolves to behind the proxy.
# Turn it on to measure, then turn it off. It 404s otherwise.
# DIAG_TOOLS=0
